{
  "name": "huddle",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11.17.0 <12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:assisted-discovery:live": "RUN_ASSISTED_DISCOVERY_LIVE_EVAL=true vitest run features/assisted-discovery/live-evaluation.manual.test.ts",
    "test:e2e": "node scripts/with-local-supabase-env.mjs playwright test",
    "test:acceptance": "node scripts/run-acceptance.mjs",
    "test:production:session": "node --env-file-if-exists=.env.production-smoke.local node_modules/@playwright/test/cli.js test --config=playwright.production.config.ts --grep=@session-smoke",
    "test:production": "node --env-file-if-exists=.env.production-smoke.local node_modules/@playwright/test/cli.js test --config=playwright.production.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:local": "node scripts/with-local-supabase-env.mjs next dev",
    "build:local": "node scripts/with-local-supabase-env.mjs npm run build",
    "db:start": "node scripts/start-local-supabase.mjs",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset --local",
    "db:lint": "supabase db lint --local --schema public,private --level error --fail-on error",
    "test:db": "supabase test db --local supabase/tests/database",
    "db:types": "node scripts/database-types.mjs",
    "db:types:check": "node scripts/database-types.mjs --check",
    "sports:sync": "node --env-file-if-exists=.env.local scripts/run-sports-sync.mjs",
    "security:audit": "node scripts/security-audit.mjs",
    "auth:config:check": "node scripts/supabase-auth-config.mjs --check",
    "auth:config:apply": "node scripts/supabase-auth-config.mjs --apply"
  },
  "dependencies": {
    "@polar-sh/sdk": "1.0.0-alpha.19",
    "@shadcn/react": "0.3.1",
    "@supabase/ssr": "0.12.5",
    "@supabase/supabase-js": "2.112.4",
    "@tanstack/react-query": "5.102.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.34.0",
    "maplibre-gl": "6.6.0",
    "next": "16.3.2",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.2",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "supabase": "2.115.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
