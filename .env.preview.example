# Vercel Preview must use a dedicated non-production Supabase project.
NEXT_PUBLIC_SUPABASE_URL=https://replace-with-preview-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-preview-publishable-key
# Vercel Preview derives NEXT_PUBLIC_APP_URL from its validated stable branch URL.
# Set it explicitly only when previewing on another HTTPS host.
# NEXT_PUBLIC_APP_URL=https://replace-with-non-vercel-preview.example
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace-with-preview-turnstile-site-key

# Server-only Preview values. Scope every value to the project-wide Vercel Preview
# environment, never to an individual feature branch.
HUDDLE_ENVIRONMENT=preview
SUPABASE_SERVICE_ROLE_KEY=replace-with-preview-service-role-key
FOOTBALL_DATA_API_TOKEN=replace-with-preview-football-data-token
SPORTS_SYNC_SECRET=replace-with-a-distinct-preview-sync-secret-at-least-32-characters
DISCOVERY_CURSOR_SECRET=replace-with-a-distinct-preview-cursor-secret-at-least-32-characters
AUTH_RECOVERY_TOKEN_SECRET=replace-with-a-distinct-preview-recovery-secret-at-least-32-characters
# Preview never contacts the shared Sandbox organization. These are synthetic,
# non-network placeholders; only the later authorized live Huddle demo may call Polar.
POLAR_ACCESS_TOKEN=replace-with-synthetic-preview-polar-token
POLAR_WEBHOOK_SECRET=replace-with-synthetic-preview-polar-webhook-secret
POLAR_ORGANIZATION_ID=00000000-0000-4000-8000-000000000001
POLAR_VENUE_MONTHLY_PRODUCT_ID=00000000-0000-4000-8000-000000000002
POLAR_VENUE_YEARLY_PRODUCT_ID=00000000-0000-4000-8000-000000000003
HUDDLE_AUTOMATION_BLOCK_POLAR_NETWORK=true
AUTH_TURNSTILE_ENABLED=false
# TURNSTILE_SECRET=replace-with-preview-turnstile-secret
# TURNSTILE_HOSTNAMES=replace-with-stable-preview-host.example
ASSISTED_DISCOVERY_ENABLED=false
# ASSISTED_DISCOVERY_TOKEN_SECRET=replace-with-a-distinct-preview-intent-secret-at-least-32-characters
# CLOUDFLARE_ACCOUNT_ID=replace-with-preview-cloudflare-account-id
# CLOUDFLARE_WORKERS_AI_API_TOKEN=replace-with-preview-workers-ai-api-token
