# Vercel Preview must use a dedicated non-production Supabase project.
NEXT_PUBLIC_SUPABASE_URL=https://replace-with-preview-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-preview-publishable-key
NEXT_PUBLIC_APP_URL=https://replace-with-preview-deployment.vercel.app

# Server-only Preview values. Scope every value to the Vercel Preview environment.
HUDDLE_ENVIRONMENT=preview
SUPABASE_SERVICE_ROLE_KEY=replace-with-preview-service-role-key
FOOTBALL_DATA_API_TOKEN=replace-with-preview-football-data-token
SPORTS_SYNC_SECRET=replace-with-a-distinct-preview-sync-secret-at-least-32-characters
DISCOVERY_CURSOR_SECRET=replace-with-a-distinct-preview-cursor-secret-at-least-32-characters
ASSISTED_DISCOVERY_ENABLED=false
# ASSISTED_DISCOVERY_TOKEN_SECRET=replace-with-a-distinct-preview-intent-secret-at-least-32-characters
# CLOUDFLARE_ACCOUNT_ID=replace-with-preview-cloudflare-account-id
# CLOUDFLARE_WORKERS_AI_API_TOKEN=replace-with-preview-workers-ai-api-token
