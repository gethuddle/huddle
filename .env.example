# Browser-safe configuration
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-the-local-publishable-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only configuration. Never expose these values to Client Components.
HUDDLE_ENVIRONMENT=local
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key
FOOTBALL_DATA_API_TOKEN=replace-with-your-football-data-api-token
SPORTS_SYNC_SECRET=replace-with-a-high-entropy-sync-secret
DISCOVERY_CURSOR_SECRET=replace-with-a-separate-32-character-cursor-secret

# AI-assisted discovery is off unless all server-only provider values are configured.
ASSISTED_DISCOVERY_ENABLED=false
# ASSISTED_DISCOVERY_TOKEN_SECRET=replace-with-a-separate-32-character-intent-secret
# CLOUDFLARE_ACCOUNT_ID=replace-with-your-cloudflare-account-id
# CLOUDFLARE_WORKERS_AI_API_TOKEN=replace-with-your-workers-ai-api-token
