# Browser-safe configuration
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-the-local-publishable-key
NEXT_PUBLIC_APP_URL=http://localhost:3000
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace-with-your-turnstile-site-key

# Server-only configuration. Never expose these values to Client Components.
HUDDLE_ENVIRONMENT=local
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key
FOOTBALL_DATA_API_TOKEN=replace-with-your-football-data-api-token
SPORTS_SYNC_SECRET=replace-with-a-high-entropy-sync-secret
DISCOVERY_CURSOR_SECRET=replace-with-a-separate-32-character-cursor-secret
AUTH_RECOVERY_TOKEN_SECRET=replace-with-a-separate-32-character-recovery-secret

# Local is never allowed to contact Polar. These are deliberately synthetic,
# non-network placeholders; use managed values only in a later authorized live demo.
POLAR_ACCESS_TOKEN=replace-with-synthetic-local-polar-token
POLAR_WEBHOOK_SECRET=replace-with-synthetic-local-polar-webhook-secret
POLAR_ORGANIZATION_ID=00000000-0000-4000-8000-000000000001
POLAR_VENUE_MONTHLY_PRODUCT_ID=00000000-0000-4000-8000-000000000002
POLAR_VENUE_YEARLY_PRODUCT_ID=00000000-0000-4000-8000-000000000003
# Deny Polar network access locally. Automated quality commands enforce this too.
HUDDLE_AUTOMATION_BLOCK_POLAR_NETWORK=true

# Bot protection is off for deterministic local development unless fully configured.
AUTH_TURNSTILE_ENABLED=false
# TURNSTILE_SECRET=replace-with-your-turnstile-widget-secret
# TURNSTILE_HOSTNAMES=localhost,127.0.0.1

# AI-assisted discovery is off unless all server-only provider values are configured.
ASSISTED_DISCOVERY_ENABLED=false
# ASSISTED_DISCOVERY_TOKEN_SECRET=replace-with-a-separate-32-character-intent-secret
# CLOUDFLARE_ACCOUNT_ID=replace-with-your-cloudflare-account-id
# CLOUDFLARE_WORKERS_AI_API_TOKEN=replace-with-your-workers-ai-api-token
