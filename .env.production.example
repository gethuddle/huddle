# Public production configuration. Replace placeholders only in managed secret stores.
NEXT_PUBLIC_SUPABASE_URL=https://replace-with-production-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-production-publishable-key
NEXT_PUBLIC_APP_URL=https://replace-with-production-domain.example

# Server-only Production values. Scope every value to the Vercel Production environment.
HUDDLE_ENVIRONMENT=production
SUPABASE_SERVICE_ROLE_KEY=replace-with-production-service-role-key
FOOTBALL_DATA_API_TOKEN=replace-with-production-football-data-token
SPORTS_SYNC_SECRET=replace-with-a-distinct-production-sync-secret-at-least-32-characters
DISCOVERY_CURSOR_SECRET=replace-with-a-distinct-production-cursor-secret-at-least-32-characters
