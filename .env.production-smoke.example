# Local-only runner inputs. Copy to .env.production-smoke.local; never commit real values.
HUDDLE_PRODUCTION_URL=https://replace-with-production-domain.example
HUDDLE_SMOKE_ATTENDEE_EMAIL=replace-with-dedicated-attendee@example.com
HUDDLE_SMOKE_ATTENDEE_PASSWORD=replace-with-dedicated-attendee-password
HUDDLE_SMOKE_ATTENDEE_HANDLE=replace_with_attendee_handle
HUDDLE_SMOKE_ATTENDEE_DISPLAY_NAME=Replace with attendee display name
HUDDLE_SMOKE_HOST_EMAIL=replace-with-dedicated-host@example.com
HUDDLE_SMOKE_HOST_PASSWORD=replace-with-dedicated-host-password
HUDDLE_SMOKE_VENUE_SLUG=replace-with-host-owned-venue-slug

# Full smoke only: a fresh eligible home event owned by the host account.
HUDDLE_SMOKE_EVENT_ID=00000000-0000-4000-8000-000000000000
